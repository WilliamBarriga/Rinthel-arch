specification { node servicio { color azul } }
model { servicio api }
theme t {
  palette { azul "#2563eb"  verde "#16a34a" }
  node {
    layer forma rect { radius 4 }
    layer relleno solid { color azul }
    slots { title attrs }
    diagram architecture {
      layer relleno { color verde }
      slots row pad 20 { title attrs }
    }
  }
}
view v { type architecture  include **  theme t }
