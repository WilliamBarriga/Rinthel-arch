exports[`renderToSvgString > dibuja la Vista con el Tema neutro (snapshot) 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 517 138">
<rect width="517" height="138" fill="#ffffff"/>
<defs><marker id="flecha" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="8" markerHeight="8" orient="auto"><path d="M 0 0 L 10 5 L 0 10 z" fill="#9ca3af"/></marker></defs>
<g data-id="a" transform="translate(12 12)">
<rect width="320" height="107" rx="6" fill="#ffffff" stroke="#2563eb"/>
<text x="10" y="22" font-family="sans-serif" font-size="14" fill="#1f2937">Plataforma</text>
<g data-id="a.api" transform="translate(16 40)">
<rect width="120" height="48" rx="6" fill="#ffffff" stroke="#2563eb"/>
<text x="60" y="24" text-anchor="middle" dominant-baseline="central" font-family="sans-serif" font-size="14" fill="#1f2937">API</text>
</g>
<g data-id="a.auth" transform="translate(156 32)">
<rect width="148" height="48" rx="6" fill="#ffffff" stroke="#2563eb"/>
<text x="74" y="24" text-anchor="middle" dominant-baseline="central" font-family="sans-serif" font-size="14" fill="#1f2937">Auth &amp; &lt;Tokens&gt;</text>
</g>
</g>
<g data-id="db" transform="translate(385 78)">
<rect width="120" height="48" rx="6" fill="#ffffff" stroke="#dc2626"/>
<text x="60" y="24" text-anchor="middle" dominant-baseline="central" font-family="sans-serif" font-size="14" fill="#1f2937">Postgres</text>
</g>
<path data-edge="a.api -&gt; db" d="M 148 84 L 158 84 L 158 102 L 385 102" fill="none" stroke="#9ca3af" marker-end="url(#flecha)"/>
<text data-cardinality="a.api -&gt; db:from" x="156" y="80" font-family="sans-serif" font-size="11.2" fill="#1f2937">1</text>
<text data-cardinality="a.api -&gt; db:to" x="377" y="98" font-family="sans-serif" font-size="11.2" fill="#1f2937">0..*</text>
<path data-edge="a.api -&gt; a.auth" d="M 148 68 L 168 68" fill="none" stroke="#9ca3af" marker-end="url(#flecha)"/>
</svg>"
`;

