// Paso 6: el mismo Modelo en otros Tipos de diagrama (secuencia y ER), con el Tema del paso 4.
specification {
  node actor    { description "Quien usa el sistema"       icon user     color purple }
  node servicio { description "Pieza de logica"            icon server   color blue }
  node almacen  { description "Datos que persisten"        icon database color green }
  node cola     { description "Canal de mensajes"          icon queue    color amber }
  node externo  { description "Sistema de terceros"        icon cloud    color red }
  node dominio  { description "Agrupa piezas relacionadas" icon box      color gray }
}

model {
  actor cliente "Cliente" "Hace pedidos"
  servicio api "API" "Punto de entrada"

  dominio tienda "Tienda" {
    servicio pedidos "Pedidos" "Registra pedidos"
    servicio pagos "Pagos" "Cobra los pedidos"
    cola eventos "Eventos"
    almacen db "Base de datos" {
      attrs {
        id: uuid
        total: decimal "en centavos"
      }
    }
  }

  externo stripe "Pasarela de pago"

  cliente -> api "HTTP"
  api -> tienda.pedidos
  tienda.pedidos -> tienda.eventos "pedido creado"
  tienda.eventos -> tienda.pagos
  tienda.pagos -> stripe "cobra"
  tienda.pedidos -> tienda.db

  // Tablas para la Vista ER: son Nodos como los demas, con Atributos y claves.
  dominio datos "Datos" {
    almacen clientes "Clientes" {
      id: uuid pk
      email: text? uk
    }
    almacen pedidos-tabla "Pedidos" {
      id: uuid pk
      cliente_id: uuid fk
      total: decimal "en centavos"
    }
  }
  datos.pedidos-tabla#cliente_id "0..*" -> "1" datos.clientes#id "pertenece a"

  // Una Interaccion: un escenario ordenado entre Nodos del Modelo (las Lifelines).
  interaction comprar "Comprar" {
    cliente -> api "POST /pedidos"
    api -> tienda.pedidos "registrar"
    alt "pago aprobado" {
      tienda.pedidos -> tienda.pagos "cobrar"
      tienda.pagos -> stripe "cargo"
      reply stripe -> tienda.pagos "ok"
    } else "pago rechazado" {
      reply tienda.pagos -> tienda.pedidos "rechazado"
    }
    note right of stripe "idempotente"
    reply api -> cliente "201"
  }
}

view principal {
  theme tienda
  type architecture
  include **
  exclude datos, datos.**
  collapsed tienda
  link tienda -> tienda-detalle
}

view tienda-detalle {
  theme tienda
  type architecture
  include tienda.**, api, stripe
}

view comprar-secuencia {
  theme tienda
  type sequence
  interaction comprar
  order cliente, api, tienda.pedidos, tienda.pagos, stripe
  autonumber
}

view tablas {
  theme tienda
  type er
  include datos.clientes, datos.pedidos-tabla
}
