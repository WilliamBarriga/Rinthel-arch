// Catalog of Node kinds and Themes of the rinthel-arch map (the system documents itself).
specification {
  node actor    { description "Person or agent that uses the system"        icon user      color purple }
  node package  { description "pnpm package of the monorepo"                  icon box       color blue }
  node module   { description "Deep module inside a package"       icon box       color gray }
  node artifact { description "File or folder that is read or produced"  icon box       color green }
  node output   { description "System output"                          icon box       color amber }
  node external  { description "Third-party library or tool"         icon cloud     color red }
  node process  { description "Running process"                       icon server    color blue }
}

// Themes of the map: the card of the built-ins (neutral-dark and neutral) with the Workspace fonts and
// two patches per Node kind (ADR 0008): the package gets a bar of its color on the left and the external one, a dashed border.
theme diagrams extends neutral-dark {
  fonts { body "DejaVu Sans"  mono "DejaVu Sans Mono"  fallback "sans-serif" }
  node { type package { use bar-package }  type external { use border-dashed } }
}

theme diagrams-light extends neutral {
  fonts { body "DejaVu Sans"  mono "DejaVu Sans Mono"  fallback "sans-serif" }
  node { type package { use bar-package }  type external { use border-dashed } }
}

part bar-package { layer acento shadow after borde { color COLOR  x 3  y 0  inset 1 } }
part border-dashed { layer relleno { color fondo }  layer borde dashed { color marco } }
