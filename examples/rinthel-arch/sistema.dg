    }
  }

  paquete shell "shell" "VistaInteractiva sobre render: camara, Seleccion, ruta y foco, colapso, Pasos, hash y arrastres que avisan al padre" {
    source { path "packages/shell/src" }
    modulo sh-vista "shell/vista-interactiva" "VistaInteractiva: une camara, Seleccion, arrastre, Pasos, navegacion y chrome; cada estado controlado o interno" {
      source { file "packages/shell/src/vista-interactiva.tsx" }
    }
    modulo sh-geometria "shell/geometria" "Geometria de la Vista activa con cache por estructura; los Pins se aplican despues sin relayout" {
      source { file "packages/shell/src/geometria.ts" }
    }
    modulo sh-camara "shell/camara" "Pan y zoom con d3-zoom" {
      source { file "packages/shell/src/camara.ts" }
    }
    modulo sh-viewport "shell/viewport" "Ventana visible y encuadre de la Vista" {
      source { file "packages/shell/src/viewport.ts" }
    }
    modulo sh-zoom-semantico "shell/zoom-semantico" "Detalle segun el nivel de zoom" {
      source { file "packages/shell/src/zoom-semantico.ts" }
    }
    modulo sh-colapso "shell/colapso" "Colapso y expansion de Grupos" {
      source { file "packages/shell/src/colapso.ts" }
    }
    modulo sh-seleccion "shell/seleccion" "Seleccion de Nodos, Aristas, Mensajes, Notas, Lifelines y Fragmentos" {
      source { file "packages/shell/src/seleccion.ts" }
    }
    modulo sh-ruta-foco "shell/ruta-y-foco" "Ruta mas corta y foco de teclado, puro: estados en-ruta, atenuado y foco para render" {
      source { file "packages/shell/src/ruta-y-foco.ts" }
    }
    modulo sh-interaccion "shell/interaccion" "Maquina de gestos: clic, arrastre y teclado (hit-test sobre la Geometria)" {
      source { file "packages/shell/src/interaccion.ts" }
    }
    modulo sh-configuracion "shell/configuracion" "Umbrales y margenes de la interaccion (tuning)" {
      source { file "packages/shell/src/configuracion.ts" }
    }
    modulo sh-caja "shell/caja" "Punto dentro de caja: la unica version del borde para hit-test y arrastre" {
      source { file "packages/shell/src/caja.ts" }
    }
    modulo sh-arrastre "shell/arrastre" "Arrastre de un Nodo: avisa al padre con onMoveNode, sin escribir; vuelve si se rechaza" {
