  package dev-ui "dev-ui" "Dev UI in the browser: DSL editor, canvas, Themes, Issues, Undo history and agent activity" {
    source { path "packages/estudio" }
    module dui-index "dev-ui/index" "activosDelEstudio: on-disk paths of the static files in dist/estudio/" {
      source { file "packages/estudio/src/index.ts" }
    }
    module dui-routes "dev-ui/routes" "RUTA_DEL_ESTUDIO: the /_estudio prefix and the build's static files" {
      source { file "packages/estudio/src/rutas.ts" }
    }
    module dui-protocol "dev-ui/protocol" "The dev protocol as the page sees it; re-exports canonical/dev" {
      source { file "packages/estudio/src/protocolo.ts" }
    }
    module dui-build "dev-ui/build" "construirEstudio: index.html, chunked pagina.js, worker.js and estilo.css with esbuild" {
      source { file "packages/estudio/src/construir.ts" }
    }
    module dui-contract "dev-ui/contract" "probarContratoDeDev: the suite that runs the same against devEnMemoria and the real dev" {
      source { file "packages/estudio/src/contrato.ts" }
    }
    module dui-in-memory-dev "dev-ui/in-memory-dev" "devEnMemoria: the real live Workspace over puertoEnMemoria; only the transport is fake" {
      source { file "packages/estudio/src/dev-en-memoria.ts" }
    }
    module dui-sse "dev-ui/sse" "Incremental text/event-stream reader for fetch-based tests" {
      source { file "packages/estudio/src/sse.ts" }
    }

    module dui-web "dev-ui/browser" "The dev page, one folder per feature" {
      source { path "packages/estudio/navegador" }
      module web-dev "browser/dev" "Page entry: real dependencies (fetch, EventSource, Worker) and mounts the Dev UI" {
        source { file "packages/estudio/navegador/dev.tsx" }
