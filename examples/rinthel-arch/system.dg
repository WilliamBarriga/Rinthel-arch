    }
    module ren-element "render/element" "Scene element: the type scene produces and the SVG consumes" {
      source { file "packages/render/src/elemento.ts" }
    }
    module ren-code "render/code" "Bridge to the code Theme (.tsx)" {
      source { file "packages/render/src/codigo.ts" }
    }
  }

