// The nine monorepo packages with their real modules (ADR 0004), the actors, the artifacts and the external libraries.
// One `module` per file of `packages/<package>/src` (and of `packages/estudio/navegador`, grouped by feature);
// the dependencies are in `connections.dg`.
model {
  actor author "Author" "Writes .dg files and works in the Dev UI: editor, canvas, Themes and Undo history"
  actor agent "Agent" "Validates, queries and edits through the CLI with stable JSON output"

  artifact workspace "Workspace" "Folder of .dg files, .tsx Themes and fonts of the documented Project"
  artifact dg-code-theme "Code Theme (.tsx)" "Workspace's own painters; require --trust-code"
  artifact workspace-fonts "Workspace fonts" "woff2, woff, ttf and otf served under /fuentes"
  artifact registry-activity "Activity log" ".diagrams/actividad.jsonl: one Event per validate, build, inspect or edit"
  output derived-output ".diagrams/" "Derived output (SVG, HTML); not versioned"
  output html-viewer "Dev UI in the browser" "index.html, pagina.js, worker.js and estilo.css from dist/estudio/"

  process server-dev "Dev server" "HTTP on 127.0.0.1 only: Dev UI static files, /api/*, SSE and disk watcher"
  process worker-layout "Layout Web Worker" "Relayout off the UI thread"

  package canonical "canonical" "Zod schema, validation, View resolution, Steps, Pins and queries; base with no internal dependencies" {
    source { path "packages/canonico/src" }
    module can-schema "canonical/schema" "Canonical form: Model, Views, Theme and Steps as Zod schemas" {
      source { file "packages/canonico/src/esquema.ts" }
    }
    module can-codes "canonical/codes" "Stable catalog of the E_ and W_ Issue codes" {
      source { file "packages/canonico/src/codigos.ts" }
    }
    module can-issue "canonical/issue" "Shape of an Issue: code, severity, site, hint and fix" {
      source { file "packages/canonico/src/issue.ts" }
    }
    module can-suggestions "canonical/suggestions" "Edit-distance candidates for hints and fixes" {
      source { file "packages/canonico/src/sugerencias.ts" }
    }
    module can-icons "canonical/icons" "Valid icons for Node kinds" {
      source { file "packages/canonico/src/iconos.ts" }
    }
    module can-validate "canonical/validate" "Semantic validation of the Model and Views, with codes and suggestions" {
      source { file "packages/canonico/src/validar.ts" }
    }
    module can-views "canonical/views" "Resolution of include, exclude, depth, expanded and link into a resolved View" {
      source { file "packages/canonico/src/vistas.ts" }
    }
    module can-steps "canonical/steps" "Cumulative reveal of flow Views: show and hide per Step" {
      source { file "packages/canonico/src/pasos.ts" }
    }
    module can-sequence "canonical/sequence" "Resolution of an Interaction for a sequence View: Lifelines (by order and first appearance) and activations" {
      source { file "packages/canonico/src/secuencia.ts" }
    }
    module can-pin "canonical/pin" "Pin: position fixed by the author, relative to the parent Group" {
      source { file "packages/canonico/src/pin.ts" }
    }
    module can-edit "canonical/edit" "Shape of a structured edit and its result" {
      source { file "packages/canonico/src/edit.ts" }
    }
    module can-inspect "canonical/inspect" "Model queries: ids, neighbors and search" {
      source { file "packages/canonico/src/inspect.ts" }
    }
    module can-geometry "canonical/geometry" "Geometry types shared by layout, render and shell" {
      source { file "packages/canonico/src/geometria.ts" }
    }
    module can-dev "canonical/dev" "Dev protocol with a single owner: routes, named SSE events and state schemas, Diff, Undo history and writes" {
      source { file "packages/canonico/src/dev.ts" }
    }
    module can-activity "canonical/activity" "Schema of the activity Event (one line of actividad.jsonl) and its pure reader" {
      source { file "packages/canonico/src/actividad.ts" }
    }
    module can-route-fonts "canonical/font-route" "Route a viewer uses to request the Workspace fonts" {
      source { file "packages/canonico/src/ruta-de-fuentes.ts" }
    }
    module can-output "canonical/output" "Schemas of the CLI JSON output (contractVersion)" {
      source { file "packages/canonico/src/salida.ts" }
    }
  }

  package theme "theme" "Catalog of Primitives, Slots, Motions, Effects and sequence and ER Elements; resolved Style and Slot placement" {
    source { path "packages/tema/src" }
    module thm-catalog "theme/catalog" "Primitives and Slots with ranges and defaults; validation with suggestions" {
      source { file "packages/tema/src/catalogo.ts" }
    }
    module thm-catalog-effects "theme/catalog-effects" "Catalog Effects and their scope (per element or global)" {
      source { file "packages/tema/src/catalogo-efectos.ts" }
    }
    module thm-families "theme/families" "One Family per Primitive type: the definition of each" {
      source { path "packages/tema/src/familias" }
      module thm-fam-shape "theme/shape" "Node shapes" { source { file "packages/tema/src/familias/forma.ts" } }
      module thm-fam-fill "theme/fill" "Fills: solid, gradient, weave, stripe" { source { file "packages/tema/src/familias/relleno.ts" } }
      module thm-fam-border "theme/border" "Borders: solid, dashed, dotted" { source { file "packages/tema/src/familias/borde.ts" } }
      module thm-fam-stroke "theme/stroke" "Edge strokes, including hand-drawn" { source { file "packages/tema/src/familias/trazo.ts" } }
      module thm-fam-marker "theme/marker" "Edge ends and markers" { source { file "packages/tema/src/familias/marcador.ts" } }
      module thm-fam-text "theme/text" "Text Slots: title, description, labels" { source { file "packages/tema/src/familias/texto.ts" } }
      module thm-fam-code "theme/code" "Primitives that delegate to a code painter" { source { file "packages/tema/src/familias/codigo.ts" } }
    }
    module thm-theme "theme/theme" "Strict schema of the resolved Theme: Palette, tokens, Layers and Slots" {
      source { file "packages/tema/src/tema.ts" }
    }
    module thm-patches "theme/patches" "Patches per kind and Part: applying them over a base Theme" {
      source { file "packages/tema/src/parches.ts" }
    }
    module thm-animation "theme/animation" "Theme Motions and Effects: durations, curves and triggers" {
      source { file "packages/tema/src/animacion.ts" }
    }
    module thm-color "theme/color" "Color conversion and mixing" {
      source { file "packages/tema/src/color.ts" }
    }
    module thm-fonts "theme/fonts" "Theme font families and their fallback" {
      source { file "packages/tema/src/fuentes.ts" }
    }
    module thm-measure "theme/measure" "Injectable text measurement (canvas, estimator or table)" {
      source { file "packages/tema/src/medicion.ts" }
    }
    module thm-content "theme/content" "Which text each Slot of a Node carries" {
      source { file "packages/tema/src/contenido.ts" }
    }
    module thm-layout "theme/layout" "Content layout: columns, alignment and padding" {
      source { file "packages/tema/src/disposicion.ts" }
    }
    module thm-metrics "theme/metrics" "Metrics derived from box, Slots and measured text" {
      source { file "packages/tema/src/metricas.ts" }
    }
    module thm-sequence "theme/sequence" "Sequence Theme elements (lifeline, activation, message, fragment, note): single table of what each block accepts" {
      source { file "packages/tema/src/secuencia.ts" }
    }
    module thm-row "theme/row" "ER table row (row block): height, alternating rows and patches by key or optional" {
      source { file "packages/tema/src/fila.ts" }
    }
    module thm-messages "theme/messages" "Painting of sequence Messages and ER Edges derived from the Edge; shared by render and color-only" {
      source { file "packages/tema/src/mensajes.ts" }
    }
    module thm-derivation "theme/derivation" "Sequence and ER elements the Theme does not declare, derived from the node and edge painting" {
      source { file "packages/tema/src/derivacion.ts" }
    }
    module thm-elements "theme/elements" "Sequence and ER elements described for inspect theme (declared or derived)" {
      source { file "packages/tema/src/elementos.ts" }
    }
    module thm-slots "theme/slots" "Rectangle of each Slot inside the Node box" {
      source { file "packages/tema/src/slots.ts" }
    }
    module thm-texts-a-measure "theme/texts-to-measure" "List of texts the layout must measure before placing" {
      source { file "packages/tema/src/textos-a-medir.ts" }
    }
    module thm-style "theme/style" "Resolved Style: Metrics, painting and animation against the Theme" {
      source { file "packages/tema/src/estilo.ts" }
    }
    module thm-contrast "theme/contrast" "theme-low-contrast warnings by contrast ratio" {
      source { file "packages/tema/src/contraste.ts" }
    }
    module thm-high-contrast "theme/high-contrast" "High-contrast variant of a Theme" {
      source { file "packages/tema/src/alto-contraste.ts" }
    }
    module thm-code "theme/code" "Contract of the code Theme (.tsx) and its trusted loading" {
      source { file "packages/tema/src/codigo.ts" }
    }
    module thm-reference "theme/reference" "Generates docs/referencia-catalogo.md from the catalog" {
      source { file "packages/tema/src/referencia.ts" }
    }
    module thm-seed "theme/seed" "Deterministic seed for the hand-drawn stroke" {
      source { file "packages/tema/src/semilla.ts" }
    }
  }

  package dsl "dsl" "Text to Canonical form; Workspace merge and Theme compiler" {
    source { path "packages/dsl/src" }
    module dsl-grammar "dsl/grammar" "Langium grammar and generated parser" {
      source { path "packages/dsl/src/gramatica" }
    }
    module dsl-compile "dsl/compile" "Workspace files to Canonical form, with syntax Issues" {
      source { file "packages/dsl/src/compilar.ts" }
    }
    module dsl-builtins "dsl/builtins" "Built-in Themes: neutral and neutral-dark" {
      source { file "packages/dsl/src/incorporados.ts" }
    }
    module dsl-themes "dsl/themes" "Theme compiler: extends, palette, tokens and patches" {
      source { file "packages/dsl/src/temas.ts" }
    }
    module dsl-themes-layers "dsl/themes-layers" "Painted Layers of the Theme" {
      source { file "packages/dsl/src/temas-capas.ts" }
    }
    module dsl-themes-slots "dsl/themes-slots" "Slots and their placement in the Theme DSL" {
      source { file "packages/dsl/src/temas-slots.ts" }
    }
    module dsl-themes-animation "dsl/themes-animation" "Motions and Effects in the Theme DSL" {
      source { file "packages/dsl/src/temas-animacion.ts" }
    }
    module dsl-themes-edge "dsl/themes-edge" "Edge stroke and markers in the Theme DSL" {
      source { file "packages/dsl/src/temas-arista.ts" }
    }
    module dsl-themes-sequence "dsl/themes-sequence" "Sequence elements in the Theme DSL" {
      source { file "packages/dsl/src/temas-secuencia.ts" }
    }
    module dsl-themes-row "dsl/themes-row" "Row block (ER rows) in the Theme DSL" {
      source { file "packages/dsl/src/temas-fila.ts" }
    }
    module dsl-themes-page "dsl/themes-page" "Page background of the Theme" {
      source { file "packages/dsl/src/temas-pagina.ts" }
    }
    module dsl-themes-common "dsl/themes-common" "Utilities shared by the Theme compilers" {
      source { file "packages/dsl/src/temas-comun.ts" }
    }
    module dsl-positions "dsl/positions" "Text ranges of each AST node" {
      source { file "packages/dsl/src/posiciones.ts" }
    }
    module dsl-locator "dsl/locator" "File and line of each Node, Edge, View and Pin in the source text" {
      source { file "packages/dsl/src/ubicador.ts" }
    }
  }

  package layout "layout" "ELK and Pin; own sequence layout; cached geometry and invalidation keys" {
    source { path "packages/layout/src" }
    module lay-layout "layout/layout" "View resolved to Geometry with ELK (INCLUDE_CHILDREN), Pins, Edge labels and claveDeEstructura / claveDeLayout" {
      source { file "packages/layout/src/layout.ts" }
    }
    module lay-sequence "layout/sequence" "Own sequence layout, no ELK, deterministic and synchronous: Lifeline columns and Message rows" {
      source { file "packages/layout/src/secuencia.ts" }
    }
    module lay-index "layout/index" "Geometry index to locate Nodes and Edges" {
      source { file "packages/layout/src/indice.ts" }
    }
  }

  package session "session" "Session (compile, validate, layout), single write over the text and live Workspace: dev state without transport" {
    source { path "packages/sesion/src" }
    module ses-session "session/session" "abrirSesion: diagnose, build, geometry, style and query, memoizing layout per View" {
      source { file "packages/sesion/src/sesion.ts" }
    }
    module ses-queries "session/queries" "inspect search, node, view and interaction over the Canonical form, with suggestions when nothing is found" {
      source { file "packages/sesion/src/consultas.ts" }
    }
    module ses-query-theme "session/theme-query" "inspect theme: extends chain, Layers, Elements, Slots and Metrics" {
      source { file "packages/sesion/src/consulta-de-tema.ts" }
    }
    module ses-apply "session/apply" "aplicarAlWorkspace: the single write gate (Intent or edits with hash, all or nothing)" {
      source { file "packages/sesion/src/aplicar.ts" }
    }
    module ses-intents "session/intents" "Pure Intent reducer and Intent history (undo and redo)" {
      source { file "packages/sesion/src/intenciones.ts" }
    }
    module ses-gestures "session/gestures" "Gestures: what to locate and what text to write for each Intent (internal)" {
      source { file "packages/sesion/src/gestos.ts" }
    }
    module ses-edits "session/edits" "Loose text edits over located ranges, with a hash per file" {
      source { file "packages/sesion/src/ediciones.ts" }
    }
    module ses-diff "session/diff" "diferenciar: the pure Diff between two Canonical forms, element by element" {
      source { file "packages/sesion/src/diferencia.ts" }
    }
    module ses-change "session/change" "clasificarCambio: paint, structure or code; what the viewer must redo" {
      source { file "packages/sesion/src/cambio.ts" }
    }
    module ses-workspace-live "session/live-workspace" "Live Workspace: current and last-good Session, write queue, versions and sole owner of the event sequence" {
      source { file "packages/sesion/src/workspace-vivo.ts" }
    }
    module ses-history-files "session/file-history" "Dev history per file: undo, redo and jump; rejects if a file changed outside" {
      source { file "packages/sesion/src/historial-de-archivos.ts" }
    }
    module ses-registry-live "session/live-activity-log" "What dev shows of the Activity log: earlier events on connect and new ones with debounce" {
      source { file "packages/sesion/src/registro-de-actividad-vivo.ts" }
    }
    module ses-clock "session/clock" "Injected clock and shared debounce (the core has no clock of its own)" {
      source { file "packages/sesion/src/reloj.ts" }
    }
    module ses-api-dev "session/dev-api" "atenderApiDeDev: request to full response; a route table gives routing, 404 and 405" {
      source { file "packages/sesion/src/api-de-dev.ts" }
    }
    module ses-port-memory "session/in-memory-port" "In-memory Workspace port (disk fake)" {
      source { file "packages/sesion/src/puerto-en-memoria.ts" }
    }
    module ses-port-live-memory "session/in-memory-live-port" "puertoEnMemoria: PuertoDelWorkspaceVivo with watchers, resources and activity" {
      source { file "packages/sesion/src/puerto-vivo-en-memoria.ts" }
    }
  }

  package render "render" "Pure React SVG: Geometry (graph or sequence) and Style to painted elements" {
    source { path "packages/render/src" }
    module ren-diagram "render/diagram" "Diagram component: Geometry and Theme to SVG" {
      source { file "packages/render/src/diagram.tsx" }
    }
    module ren-limit "render/boundary" "Error boundary that isolates a broken code painter" {
      source { file "packages/render/src/limite.tsx" }
    }
    module ren-scene "render/scene" "Geometry to a list of elements ordered by stack" {
