    module ren-paint "render/paint" "Painters for shape, fill, border and page" {
      source { path "packages/render/src/pintura" }
      module ren-pin-common "render/common" "Shared rules, such as 'is border'" { source { file "packages/render/src/pintura/comun.ts" } }
      module ren-pin-shape "render/shape" "Shape path" { source { file "packages/render/src/pintura/forma.ts" } }
      module ren-pin-fill "render/fill" "Fills and gradients" { source { file "packages/render/src/pintura/relleno.ts" } }
      module ren-pin-border "render/border" "Borders" { source { file "packages/render/src/pintura/borde.ts" } }
