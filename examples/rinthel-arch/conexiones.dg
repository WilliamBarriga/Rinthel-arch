// Dependencias entre paquetes (orden: canonico -> tema -> dsl / layout -> sesion -> render -> shell -> estudio -> cli),
// entre modulos y flujo de datos. Las Aristas se declaran solo aqui, con ids cualificados. Las de paquete salen de
// package.json; las de modulo, de los imports de cada archivo (las de otro paquete, resueltas al modulo que define el
// simbolo; entre paquetes solo las costuras que explican el mapa: se omiten los tipos base de canonico y los cruces
// repetidos que no anaden lectura).
model {
  // Actores, artefactos y procesos
  autor -> workspace "escribe .dg"
  autor -> visor-html "edita, arrastra y revisa"
  agente -> cli.cli-index "validate / inspect / edit"
  cli.cli-bin -> cli.cli-index
  cli.cli-workspace -> workspace "lee"
  cli.cli-workspace -> fuentes-ws "lee"
  cli.cli-codigo -> dg-tema-codigo "compila si hay confianza"
  cli.cli-dev -> workspace "escribe de forma atomica"
  cli.cli-validate -> salida-derivada "escribe (build)"
  cli.cli-registro-disco -> registro-actividad "anexa y observa"
  cli.cli-dev -> servidor-dev "levanta"
  servidor-dev -> visor-html "sirve el estudio y empuja SSE"
  visor-html -> estudio.est-nav.nav-dev "arranca"
  estudio.est-construir -> visor-html "produce dist/estudio/"
  estudio.est-nav.nav-cliente -> servidor-dev "/api/* y SSE"
  shell.sh-worker -> worker-layout "crea"
  worker-layout -> estudio.est-nav.nav-worker.wrk-worker "ejecuta"
  shell.sh-arrastre -> estudio.est-nav.nav-lienzo.lie-lienzo "onMoveNode"
  servidor-dev -> estudio.est-nav.nav-marco.mar-estado-dev "event: estado"
  servidor-dev -> estudio.est-nav.nav-agente.age-actividad "event: actividad"

  // Paquetes
  tema -> canonico
  dsl -> canonico
  dsl -> tema
  layout -> canonico
  layout -> tema
  sesion -> canonico
  sesion -> dsl
  sesion -> layout
  sesion -> tema
  render -> canonico
  render -> layout
  render -> tema
  shell -> canonico
  shell -> layout
  shell -> render
  shell -> sesion
  shell -> tema
  estudio -> canonico
  estudio -> layout
  estudio -> render
  estudio -> sesion
  estudio -> shell
  cli -> canonico
  cli -> dsl
  cli -> estudio
  cli -> layout
  cli -> sesion
  cli -> tema

  // Librerias externas
  canonico.can-esquema -> zod
  tema.tem-catalogo -> zod
  dsl.dsl-gramatica -> langium
  layout.lay-layout -> elk
  render.ren-diagram -> react
  shell.sh-camara -> d3
  estudio.est-nav.nav-estudio -> react
  estudio.est-nav.nav-editor.ed-panel -> codemirror
  estudio.est-nav.nav-marco.mar-isla -> base-ui
  estudio.est-nav.nav-comandos.cmd-buscador -> base-ui
  estudio.est-construir -> esbuild "empaqueta la pagina y el Worker"
  cli.cli-codigo -> esbuild "compila Temas .tsx"
  cli.cli-dev -> node-http

  // canonico
  canonico.can-dev -> canonico.can-actividad
  canonico.can-dev -> canonico.can-edit
  canonico.can-dev -> canonico.can-esquema
