// La Fuente canonica como esquema de datos (Vista ER) y dos Interacciones del sistema (Vistas de secuencia).
model {
  artefacto fuente "Fuente canonica" {
    version: int pk
    hash: text "por archivo"
  }
  artefacto f-nodo "Nodo" {
    id: text pk "cualificado con ."
    tipo: text
    titulo: text?
    padre: text? fk
  }
  artefacto f-arista "Arista" {
    id: text pk
    origen: text fk
    destino: text fk
    etiqueta: text?
  }
  artefacto f-vista "Vista" {
    id: text pk
    tipo: text "architecture, flow, sequence, er"
    tema: text?
    interaccion: text? fk
  }
  artefacto f-paso "Paso" {
    vista: text pk fk
    orden: int pk
    corte: text? "Mensaje (secuencia)"
  }
  artefacto f-interaccion "Interaccion" {
    id: text pk
    titulo: text
  }
  artefacto f-mensaje "Mensaje" {
    interaccion: text pk fk
    ruta: text pk
    origen: text fk
    destino: text fk
  }

  f-nodo#padre "0..1" -> "0..*" f-nodo#id "contiene"
  f-arista#origen "0..*" -> "1" f-nodo#id "sale de"
  f-arista#destino "0..*" -> "1" f-nodo#id "llega a"
  f-vista#interaccion "0..*" -> "0..1" f-interaccion#id "proyecta"
  f-paso#vista "0..*" -> "1" f-vista#id "revela" identifying
  f-mensaje#interaccion "1..*" -> "1" f-interaccion#id "compone" identifying
  f-mensaje#origen "0..*" -> "1" f-nodo#id "Lifeline origen"
  f-mensaje#destino "0..*" -> "1" f-nodo#id "Lifeline destino"

  interaction editar-pin "Editar un Pin" "Arrastrar un Nodo en la UI de dev reescribe el archivo .dg" {
    arrastre: autor -> shell.sh-arrastre "arrastra un Nodo"
    shell.sh-arrastre -> estudio.est-nav.nav-lienzo.lie-lienzo "onMoveNode(centro)"
    estudio.est-nav.nav-lienzo.lie-lienzo -> estudio.est-nav.nav-escritura "Intencion mover-pin"
    estudio.est-nav.nav-escritura -> cli.cli-dev "POST /api/edit con version"
    note over cli.cli-dev "delega en atenderApiDeDev"
    cli.cli-dev -> sesion.ses-workspace-vivo "aplicar la Intencion"
    alt "version vigente" {
      async sesion.ses-workspace-vivo -> workspace "reescribe el .dg"
      ref recompilar
    } else "archivo cambio en disco" {
      note over sesion.ses-workspace-vivo "rechaza con hash-desactualizado"
    }
    reply sesion.ses-workspace-vivo -> cli.cli-dev "nueva version o rechazo"
    reply cli.cli-dev -> estudio.est-nav.nav-escritura "200 o 409"
    reply estudio.est-nav.nav-escritura -> estudio.est-nav.nav-lienzo.lie-lienzo "ante 409 recarga y avisa"
    reply estudio.est-nav.nav-lienzo.lie-lienzo -> shell.sh-arrastre "true o false"
    note right of workspace "ni .diagrams/ ni la Fuente se tocan a mano"
    fin: reply shell.sh-arrastre -> autor "el Nodo queda o vuelve a su sitio"
  }

  interaction recompilar "Recompilar" "El Workspace vivo recompila y decide que debe rehacer el visor" {
    sesion.ses-workspace-vivo -> sesion.ses-sesion "actualizar"
    sesion.ses-sesion -> dsl.dsl-compilar "compila los archivos"
    reply dsl.dsl-compilar -> sesion.ses-sesion "Fuente canonica"
    reply sesion.ses-sesion -> sesion.ses-workspace-vivo "Sesion nueva"
    sesion.ses-workspace-vivo -> sesion.ses-diferencia "diferenciar"
    reply sesion.ses-diferencia -> sesion.ses-workspace-vivo "Diferencia"
    sesion.ses-workspace-vivo -> sesion.ses-cambio "clasificarCambio"
    reply sesion.ses-cambio -> sesion.ses-workspace-vivo "pintura, estructura o codigo"
    note right of sesion.ses-cambio "la Geometria se pide despues, por Vista y bajo demanda"
  }
}

view fuente-er {
  type er
  theme diagrams
  include f-nodo, f-arista, f-vista, f-paso, f-interaccion, f-mensaje, fuente
  steps {
    step "Nodos y Aristas" { show f-nodo, f-arista }
    step "Vistas y Pasos" { show f-vista, f-paso }
    step "Interacciones y Mensajes" { show f-interaccion, f-mensaje }
  }
}

view editar-pin {
  type sequence
  theme diagrams
  interaction editar-pin
  order autor, shell.sh-arrastre, estudio.est-nav.nav-lienzo.lie-lienzo, estudio.est-nav.nav-escritura, cli.cli-dev, sesion.ses-workspace-vivo, workspace
  autonumber
  link sesion.ses-workspace-vivo -> sesion-detalle
  link shell.sh-arrastre -> shell-detalle
  link estudio.est-nav.nav-lienzo.lie-lienzo -> estudio-detalle
  steps {
    step "El autor arrastra" { upto arrastre }
    step "El Nodo queda en su sitio o vuelve" { upto fin }
  }
}

view recompilar {
  type sequence
  theme diagrams
  interaction recompilar
  order sesion.ses-workspace-vivo, sesion.ses-sesion, dsl.dsl-compilar, sesion.ses-diferencia, sesion.ses-cambio
  link sesion.ses-sesion -> sesion-detalle
}
