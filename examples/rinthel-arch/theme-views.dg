// One View per approved Theme (ADR 0008): the map `open` View with each one, to see how much the same diagram changes.
// The files in `themes/` are the only copy of the 14 Themes: the gallery (`examples/themes/gallery/`) takes them with `--theme-path`.
view open-soft-card {
  type architecture
  theme soft-card
  include author, agent, workspace, derived-output, canonical, theme, dsl, layout, session, render, shell, dev-ui, cli, render.**, session.**, layout.**, elk, react
  expanded render, layout
  collapsed canonical, theme, dsl, session, shell, dev-ui, cli, render.ren-paint
}
