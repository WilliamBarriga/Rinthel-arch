// One View per approved Theme (ADR 0008): the map `open` View with each one, to see how much the same diagram changes.
// The files in `themes/` are the only copy of the 14 Themes: the gallery (`examples/themes/gallery/`) takes them with `--theme-path`.
view open-soft-card {
  type architecture
  theme soft-card
  include author, agent, repo, repo.*, repo.scanner.*, repo.dev-ui.*, langium, zod, elk, react, d3, esbuild, tree-sitter
  expanded repo.scanner, repo.dev-ui
  collapsed repo.dev-ui.browser
}
