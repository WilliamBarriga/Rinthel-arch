// Catalogo de Tipos de nodo y Temas del mapa de rinthel-arch (el sistema se documenta a si mismo).
specification {
  node actor    { description "Persona o agente que usa el sistema"        icon user      color purple }
  node paquete  { description "Paquete pnpm del monorepo"                  icon box       color blue }
  node modulo   { description "Modulo profundo dentro de un paquete"       icon box       color gray }
  node artefacto { description "Archivo o carpeta que se lee o se produce"  icon box       color green }
  node salida   { description "Salida del sistema"                          icon box       color amber }
  node externo  { description "Libreria o herramienta de terceros"         icon cloud     color red }
  node proceso  { description "Proceso en ejecucion"                       icon server    color blue }
}

// Temas del mapa: la tarjeta de los incorporados (neutral-dark y neutral) con las fuentes del Workspace y
// dos parches por Tipo (ADR 0008): el paquete lleva una barra de su color a la izquierda y el externo, borde discontinuo.
theme diagrams extends neutral-dark {
  fonts { body "DejaVu Sans"  mono "DejaVu Sans Mono" }
  node { type paquete { use acento }  type externo { use discontinuo } }
}

theme diagrams-claro extends neutral {
  fonts { body "DejaVu Sans"  mono "DejaVu Sans Mono" }
  node { type paquete { use acento }  type externo { use discontinuo } }
}

part acento { layer acento shadow after borde { color COLOR  x 3  y 0  inset 1 } }
part discontinuo { layer relleno { color fondo }  layer borde dashed { color marco } }
