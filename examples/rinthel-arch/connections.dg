// Dependencies between packages (order: canonical -> theme -> dsl / layout -> session -> render -> shell -> dev-ui -> cli),
// between modules and data flow. Edges are declared only here, with qualified ids. Package ones come from
// package.json; module ones, from the imports of each file (those to another package, resolved to the module that defines the
// symbol; between packages only the seams that explain the map: the base types of canonical and the
// repeated crossings that add no reading value are omitted).
model {
  // Actors, artifacts and processes
  author -> workspace "writes .dg"
  author -> html-viewer "edits, drags and reviews"
  agent -> cli.cli-index "validate / inspect / edit"
  cli.cli-bin -> cli.cli-index
  cli.cli-workspace -> workspace "reads"
  cli.cli-workspace -> workspace-fonts "reads"
  cli.cli-code -> dg-code-theme "compiles if trusted"
  cli.cli-dev -> workspace "writes atomically"
  cli.cli-validate -> derived-output "writes (build)"
  cli.cli-registry-disk -> registry-activity "appends and watches"
  cli.cli-dev -> server-dev "starts"
  server-dev -> html-viewer "serves the Dev UI and pushes SSE"
  html-viewer -> dev-ui.dui-web.web-dev "starts"
  dev-ui.dui-build -> html-viewer "produces dist/estudio/"
  dev-ui.dui-web.web-client -> server-dev "/api/* y SSE"
  shell.sh-worker -> worker-layout "creates"
  worker-layout -> dev-ui.dui-web.web-worker.wrk-worker "runs"
  shell.sh-drag -> dev-ui.dui-web.web-canvas.cnv-canvas "onMoveNode"
  server-dev -> dev-ui.dui-web.web-frame.frm-state-dev "event: state"
  server-dev -> dev-ui.dui-web.web-agent.agt-activity "event: activity"

  // Packages
  theme -> canonical
  dsl -> canonical
  dsl -> theme
  layout -> canonical
  layout -> theme
  session -> canonical
  session -> dsl
  session -> layout
  session -> theme
  render -> canonical
  render -> layout
  render -> theme
  shell -> canonical
  shell -> layout
  shell -> render
  shell -> session
  shell -> theme
  dev-ui -> canonical
  dev-ui -> layout
  dev-ui -> render
  dev-ui -> session
  dev-ui -> shell
  cli -> canonical
  cli -> dsl
  cli -> dev-ui
  cli -> layout
  cli -> session
  cli -> theme

  // External libraries
  canonical.can-schema -> zod
  theme.thm-catalog -> zod
  dsl.dsl-grammar -> langium
  layout.lay-layout -> elk
  render.ren-diagram -> react
  shell.sh-camera -> d3
  dev-ui.dui-web.web-dev-ui -> react
  dev-ui.dui-web.web-editor.ed-panel -> codemirror
  dev-ui.dui-web.web-frame.frm-island -> base-ui
  dev-ui.dui-web.web-commands.cmd-finder -> base-ui
  dev-ui.dui-build -> esbuild "bundles the page and the Worker"
  cli.cli-code -> esbuild "compiles .tsx Themes"
  cli.cli-dev -> node-http

  // canonical
  canonical.can-dev -> canonical.can-activity
