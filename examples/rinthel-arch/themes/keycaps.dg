// Contrast: external
// Deliberate, as in the prototype: external is a hollow keycap (paper at 15 %) and its dark text is barely readable on the background; the keycap reads by its dashed border.
// 3D keycaps: each Node is a keycap with stacked solid shadows that simulate the edge, and shine on the border.
theme keycaps {
  palette {
    background "#2b2d3a"  text "#1b1c24"  light "#ffffff"  paper "#d9dce6"
    blue "#8ab4ff"  purple "#c7a6ff"  green "#86e3b5"  amber "#ffd27a"  red "#ff9a9a"  gray "#d9dce6"
  }
  fonts { body "Nunito"  mono "JetBrains Mono"  fallback "sans-serif" }
  tokens { background "#2b2d3a"  foreground "#1b1c24"  border "#d9dce6" }
  page {
    layer light radial { from mix(background, light, 0.15)  to background  x 50  y 30 }
    fixed
  }
  node {
    // The keycap edge is stacked hard shadows, each a bit darker, over the soft shadow of the floor.
    layer floor shadow { color text/0.55  x 0  y 14  blur 16 }
    layer rim-8 shadow { color mix(COLOR, text, 0.55)  x 0  y 8 }
    layer rim-6 shadow { color mix(COLOR, text, 0.5)  x 0  y 6 }
    layer rim-4 shadow { color mix(COLOR, text, 0.45)  x 0  y 4 }
    layer rim-2 shadow { color mix(COLOR, text, 0.4)  x 0  y 2 }
    layer shape rect { radius 12 }
    layer keytop gradient { from mix(COLOR, light, 0.3)  to COLOR  angle 180 }
    layer border border { color light/0.5 }
    slots column min-width 160 slack 20 {
      row gap 10 pad 12 min-height 56 {
        icon { variant box  side 30  radius 9  fill light/0.45  border light/0.6  color text }
        column {
          title { weight 800  text-align start  leading 1.25 }
          badge { alpha 0.55  size 0.7 }
        }
        counter { fill light/0.6  border text/0.3 }
      }
      attrs
    }
    type external {
      layer floor none  layer rim-8 none  layer rim-6 none  layer rim-4 none  layer rim-2 none
      layer keytop solid { color paper/0.15 }
      layer border dashed { color paper/0.5  width 2 }
    }
    // Pressed: the keycap goes down and only the first edge remains.
    state hover { layer rim-8 none  layer rim-6 none  layer rim-4 none  layer floor { color text/0.5  y 4  blur 8 }  transition 80ms ease-out }
    state on-path { layer border { color light  width 2 } }
    state dimmed { layer floor none }
  }
  group {
    // Dark tray with a rim of light on top.
    layer shine shadow { color light/0.08  x 0  y 2 }
    layer shape rect { radius 20 }
    layer fill solid { color text/0.35 }
    layer border border { color text/0.6 }
    slots row pad 12 pad-y 9 { title { size 0.8  weight 600  fill COLOR/0.2  border COLOR/0.5  radius 50  pad 10  dot COLOR } }
    padding 14 24 30 24
    // Closed is the Node keycap on a dark base that surrounds it.
    state collapsed {
      layer base solid before shine { color text/0.35  offset -4 -4  grow 8 }
      layer floor shadow before shine { color text/0.55  x 0  y 14  blur 16 }
      layer rim-8 shadow before shine { color mix(COLOR, text, 0.55)  x 0  y 8 }
      layer rim-6 shadow before shine { color mix(COLOR, text, 0.5)  x 0  y 6 }
      layer rim-4 shadow before shine { color mix(COLOR, text, 0.45)  x 0  y 4 }
      layer rim-2 shadow before shine { color mix(COLOR, text, 0.4)  x 0  y 2 }
      layer shine none
      layer shape { radius 12 }
      layer fill gradient { from mix(COLOR, light, 0.3)  to COLOR  angle 180 }
      layer border { color light/0.5 }
    }
  }
  edge {
    layer wire line { color text/0.6  width 7  corner round  radius 16  cap round }
    layer thread line { color paper/0.85  width 2.5  corner round  radius 16  cap round }
    start hollow { size 7  color text/0.7 }
    end arrow { size 10  color paper/0.85 }
    label { scale 0.82  pad 10  pad-y 2.5  radius 8  fill paper  border text/0.5  color text/0.8 }
  }
}
