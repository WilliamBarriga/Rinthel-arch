// Contrast: external
// Deliberate, as in the prototype: external is a hollow block (weave only) and its black text is barely readable on the sky; the block reads by its weave and its outline.
// 8-bit pixel art: blocks with no curves, hard 4 px black outline, inset shadow and pixel Edges.
theme pixel-art {
  fonts { body "Press Start 2P"  mono "Press Start 2P"  fallback "monospace" }
  palette {
    background "#1b1135"  text "#ffffff"  black "#0d0a1f"  light "#ffffff"  star "#ffe9a8"
    blue "#3fa9f5"  purple "#b26bff"  green "#5ee65e"  amber "#ffd23f"  red "#ff4d6d"  gray "#c0c0d0"
  }
  tokens { background "#1b1135"  foreground "#0d0a1f"  border "#ffffff" }
  // Night sky in gradient with stars.
  page {
    layer sky gradient { from background  to mix(background, purple, 0.3)  angle 180 }
    layer stars dots { color star/0.5  size 37  radius 1 }
    fixed
  }
  node {
    // Block in the kind color: hard shadow, 4 px black outline (four shadows) and bevel with inset shadows.
    layer shadow shadow { color black/0.45  x 8  y 8 }
    layer outline-right shadow { color black  x 4  y 0 }
    layer outline-left shadow { color black  x -4  y 0 }
    layer outline-bottom shadow { color black  x 0  y 4 }
    layer outline-top shadow { color black  x 0  y -4 }
    layer shape rect
    layer block solid { color COLOR }
    layer bevel-dark shadow { color black/0.35  x -4  y -4  inset 1 }
    layer bevel-light shadow { color light/0.45  x 4  y 4  inset 1 }
    slots column min-width 170 slack 50 {
      row gap 10 pad 12 min-height 58 {
        icon { variant box  side 24  radius 0  fill black/0.2  color black }
        column {
          title { weight 400  transform uppercase  size 0.68  color black  text-align start  leading 1.25 }
          badge { alpha 0.65  transform uppercase  size 0.5  color black }
        }
        counter { fill light  border black  border-width 3  color black }
      }
      attrs
    }
    type external { layer block grid { color black/0.25  size 4 } }
    state hover { layer block { color mix(COLOR, light, 0.25) }  transition 60ms linear }
    state on-path { layer ring ring after bevel-light { color light  width 2  offset 6 } }
    state dimmed { layer shadow none }
  }
  group {
    // Dark frame with a light 4 px outline.
    layer outline-right shadow { color light/0.8  x 4  y 0 }
    layer outline-left shadow { color light/0.8  x -4  y 0 }
    layer outline-bottom shadow { color light/0.8  x 0  y 4 }
    layer outline-top shadow { color light/0.8  x 0  y -4 }
    layer shape rect
    layer fill solid { color black/0.35 }
    slots row pad 12 pad-y 9 {
      title { transform uppercase  size 0.6  leading 2.5  weight 400  color text  fill amber  border text  border-width 3  radius 4  pad 10 }
    }
    padding 13 26 26 26
    // Closed is the Node block with a stack of coins (amber band) on the right.
    state collapsed {
      layer shadow shadow before outline-right { color black/0.45  x 8  y 8 }
      layer outline-right { color black }
      layer outline-left { color black }
      layer outline-bottom { color black }
      layer outline-top { color black }
      layer fill { color COLOR }
      layer bevel-dark shadow after fill { color black/0.35  x -4  y -4  inset 1 }
      layer bevel-light shadow after bevel-dark { color light/0.45  x 4  y 4  inset 1 }
      layer coins stripe after bevel-light over { color amber  side right  width 8 }
    }
  }
  edge {
    layer shadow line { color black/0.6  width 8 }
    layer line line { color light  width 4  style pixel }
    start square { size 8  color text }
    end arrow { size 10  color light }
    label { scale 0.57  pad 10  pad-y 2.5  radius 0  fill light  border black  color black  weight 400 }
  }
  // ER tables and sequence: small text so the pixel font fits, and Fragment and Note with a hard outline.
  row {
    height 30
    name { size 0.55  color black }
    type { size 0.5  color black  alpha 0.75 }
    key { size 0.4  fill light  border black  color black  radius 0 }
  }
  fragment {
    layer shape rect
    layer fill solid { color light/0.06 }
    layer border border { color light  width 2 }
    operator { scale 0.5  color black  fill amber  border black  border-width 3  radius 0  pad 6 }
    guard { size 0.5  color text }
    divider { color light  width 2  style dashed }
  }
  note {
    layer shape rect
    layer fill solid { color amber }
    layer border border { color black  width 3 }
    text { size 0.5  color black  weight 400 }
  }
}
