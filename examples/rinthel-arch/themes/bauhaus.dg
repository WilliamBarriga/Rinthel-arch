// Contrast: none
// Bauhaus: primary colors on cream paper, pure geometric shapes (pill, cut corner) and thick borders.
theme bauhaus {
  palette {
    background "#efe8d8"  text "#141414"  paper "#fbf7ee"  red "#d6301f"  yellow "#f2b705"  blue "#1f4fbf"
    blue "#1f4fbf"  purple "#141414"  green "#1f4fbf"  amber "#f2b705"  red "#d6301f"  gray "#141414"
  }
  fonts { body "sans-serif"  mono "JetBrains Mono"  fallback "sans-serif" }
  tokens { background "#efe8d8"  foreground "#141414"  border "#141414" }
  // Three discs fixed to the viewer: large blue in the center, red at the bottom left and yellow at the top right.
  page {
    layer blue disc { color blue/0.12  radius 320  x 55  y 60 }
    layer red disc { color red/0.85  radius 110  x 8  y 92 }
    layer yellow disc { color yellow/0.9  radius 170  x 88  y 18 }
    fixed
  }
  node {
    // Block in the kind color peeking out at the top left, under a paper box with a thick border.
    layer block solid { color COLOR  offset -7 -7 }
    layer shape rect
    layer fill solid { color paper }
    layer border border { color text  width 3 }
    slots column min-width 180 slack 30 {
      row gap 12 pad 14 min-height 58 {
        icon { variant box  side 26  radius 50  fill COLOR  border text  color paper }
        column {
          title { weight 800  transform uppercase  tracking 0.04  text-align start  leading 1.25 }
          badge { alpha 0.7  transform uppercase  size 0.62  tracking 0.25 }
        }
        counter { fill yellow  border text  border-width 2 }
      }
      attrs
    }
    type actor { layer shape pill }
    type external { layer block none  layer shape cut { cut 18 }  layer tint gradient after fill { from COLOR/0.25  to COLOR/0.25 } }
    state hover { layer block { offset -11 -11 }  transition 100ms linear }
    state on-path { layer fill { color yellow } }
    state dimmed { layer block none }
  }
  group {
    layer shape rect
    layer fill solid { color COLOR/0.1 }
    layer border border { color text  width 3 }
    slots row pad 12 pad-y 9 {
      title { transform uppercase  size 0.8  leading 2.3  tracking 0.2  weight 600  fill paper  border text  border-width 3  pad 10 }
    }
    padding 8 26 26 26
    // Closed is the Node box with its block and a thick band in the kind color on the right.
    state collapsed {
      layer block solid before shape { color COLOR  offset -7 -7 }
      layer fill { color paper }
      layer band stripe after border over { color COLOR  side right  width 12 }
    }
  }
  edge {
    layer line line { color text  width 3  cap round }
    start square { size 8 }
    end arrow { size 10 }
    label { scale 0.82  pad 10  pad-y 2.5  radius 0  fill yellow  border text  color text/0.8 }
  }
}
