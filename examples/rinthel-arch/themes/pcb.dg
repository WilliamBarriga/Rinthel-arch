// Contrast: none
// Printed circuit: green board, black chips, copper tracks with chamfered corners and vias at the ends.
theme pcb {
  fonts { body "JetBrains Mono"  mono "JetBrains Mono"  fallback "monospace" }
  palette {
    background "#0c4a2f"  text "#f2f2ea"  board "#0c4a2f"  chip "#16171a"  copper "#d8a24a"  tin "#c9ccd1"  silkscreen "#f2f2ea"  white "#ffffff"
    blue "#6fb7ff"  purple "#c49bff"  green "#7be38f"  amber "#ffcc55"  red "#ff7a6b"  gray "#c9ccd1"
  }
  tokens { background "#0c4a2f"  foreground "#f2f2ea"  border "#c9ccd1" }
  // Board with fiberglass (light grain) and the silkscreen dot grid.
  page {
    layer fiber noise { color white  opacity 0.07  frequency 0.8 }
    layer grid dots { color silkscreen/0.08  size 16  radius 1 }
    fixed
  }
  node {
    // Black chip with tin legs above and below and the pin 1 notch.
    layer legs pins { color tin  width 4  step 11  length 6  margin 10 }
    layer shadow shadow { color chip/0.6  x 0  y 3  blur 6 }
    layer shape rect { radius 3 }
    layer chip gradient { from chip  to mix(chip, silkscreen, 0.1)  angle 160 }
    layer notch disc { color silkscreen/0.25  radius 3  x 9  y 9  unit px }
    slots column min-width 170 slack 22 {
      row gap 10 pad 18 min-height 54 {
        icon { variant box  side 22  radius 2  fill COLOR/0.15  border COLOR/0.6 }
        column {
          title { weight 700  transform uppercase  size 0.86  tracking 0.05  text-align start  leading 1.25 }
          badge { alpha 0.5  font mono  transform uppercase  size 0.62  tracking 0.15 }
        }
        counter { fill copper  border copper  font mono }
      }
      attrs
    }
    // The actor is a copper pad; the external, a connector with copper legs and dashed silkscreen.
    type actor {
      layer legs none  layer notch none  layer shadow none
      layer shape pill
      layer chip solid { color copper/0.15 }
      layer border border after chip { color copper  width 2 }
    }
    type external {
      layer legs pins { color copper  width 6  step 16  length 8  margin 14 }
      layer shadow none  layer notch none
      layer chip solid { color board }
      layer border dashed after chip { color silkscreen/0.8  width 1.5 }
    }
    type artifact { layer shape { radius 2 }  layer chip gradient { from mix(tin, chip, 0.65)  to mix(tin, chip, 0.8)  angle 180 } }
    state hover { layer glow glow after shadow { color COLOR/0.6  radius 14 }  transition 100ms linear }
    state on-path { layer glow glow after shadow { color COLOR  radius 18 } }
    state dimmed { layer shadow none }
  }
  group {
    // Silkscreen outline with a dashed region inside.
    layer shape rect
    layer border border { color silkscreen/0.75  width 1.5 }
    layer region dashed { color silkscreen/0.25  offset 5 5  grow -10 }
    slots row pad 18 pad-y 9 { title { transform uppercase  font mono  size 0.75  leading 1.2  tracking 0.2  weight 600 } }
    padding 19 26 30 26
    // Closed is the Node chip with a thin-line heatsink on top.
    state collapsed {
      layer legs pins before shape { color tin  width 4  step 11  length 6  margin 10 }
      layer shadow shadow before shape { color chip/0.6  x 0  y 3  blur 6 }
      layer shape { radius 3 }
      layer chip gradient after shape { from chip  to mix(chip, silkscreen, 0.1)  angle 160 }
      layer notch disc after chip { color silkscreen/0.25  radius 3  x 9  y 9  unit px }
      layer heatsink lines after notch { color silkscreen/0.06  size 4  width 1  angle 0 }
      layer border none
      layer region none
    }
  }
  edge {
    layer halo line { color copper/0.25  width 7  corner chamfer  cut 10  cap round }
    layer track line { color copper  width 3  corner chamfer  cut 10  cap round }
    start via { size 10  color copper }
    end via { size 10  color copper }
    label { scale 0.75  pad 10  pad-y 2.5  radius 0  fill board  border silkscreen/0.7  border-width 1.5  font mono  weight 700  color silkscreen }
  }
}
