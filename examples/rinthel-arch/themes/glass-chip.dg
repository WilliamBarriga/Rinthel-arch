// Contrast: actor, store, artifact, queue, domain, module, probe, package, service
// Color only: module/artifact, package/artifact, package/module
// Deliberate, as in the prototype: with no badge or glyph, package, module and artifact differ only by color, and the pill white/0.2 border is decorative (its glow and tint carry the read).
// Glass chip (Raycast/Arc style): pill with glow, real glass (backdrop-filter) and a top shine.
theme glass-chip {
  palette {
    background "#0a0a14"  text "#eef0ff"  white "#ffffff"  deep "#1b1850"
    blue "#818cf8"  purple "#c084fc"  green "#2dd4bf"  amber "#fbbf24"  red "#fb7185"  gray "#94a3b8"
  }
  fonts { body "Inter"  mono "JetBrains Mono"  fallback "sans-serif" }
  tokens { background "#0a0a14"  foreground "#eef0ff"  border "#94a3b8" }
  page {
    layer light radial { from deep  to background  x 25  y 0 }
    fixed
  }
  node {
    layer glow glow { color COLOR/0.35  radius 14 }
    layer shape pill
    layer glass glass { blur 10  saturate 100 }
    layer tint gradient { from COLOR/0.30  to COLOR/0.07  angle 135 }
    layer border border { color white/0.2 }
    layer shine gradient over { from white/0.10  to white/0  angle 180 }
    // Colored dot over its ring, the title and, in a closed Group, the counter.
    slots column min-width 130 slack 12 {
      row gap 10 pad 14 pad-y 0 min-height 40 {
        icon { variant dot  side 18  ring COLOR/0.25 }
        title { weight 500  text-align start  leading 1.25 }
        counter { fill COLOR/0.35  border white/0.25 }
      }
      attrs
    }
    type external { layer glow none  layer tint solid { color white/0.04 }  layer border dashed { color white/0.5 } }
    type actor { layer halo border before glow { color COLOR/0.4  offset -4 -4  grow 8 } }
    state hover { layer glow { color COLOR/0.7  radius 22 }  transition 160ms ease-out }
    state on-path { layer glow { color COLOR  radius 26 } }
    state dimmed { layer glow none }
  }
  group {
    layer shape rect { radius 24 }
    layer glass glass { blur 4  saturate 100 }
    layer tint solid { color COLOR/0.08 }
    layer border border { color white/0.16 }
    slots row pad 12 pad-y 9 { title { size 0.85  weight 600  fill COLOR/0.2  border COLOR/0.5  radius 50  pad 10  dot COLOR } }
    padding 9 22 22 22
    // Closed is the Node pill with the border in the kind color.
    state collapsed {
      layer glow glow before shape { color COLOR/0.35  radius 14 }
      layer shape pill
      layer glass { blur 10 }
      layer tint gradient { from COLOR/0.30  to COLOR/0.07  angle 135 }
      layer border { color COLOR/0.6 }
      layer shine gradient after border over { from white/0.10  to white/0  angle 180 }
    }
  }
  edge {
    layer halo line { color text/0.08  width 6  corner round  radius 20 }
    layer line line { color text/0.55  width 1.5  corner round  radius 20 }
    start hollow { size 7  color text/0.7 }
    end arrow { size 10  color text/0.55 }
    label { scale 0.82  pad 10  pad-y 2.5  radius 50  fill background  border text/0.22  color text/0.8 }
  }
}
