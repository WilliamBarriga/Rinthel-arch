// Contrast: none
// Synthwave neon: pink to cyan gradient with intense glow and a background grid.
theme synthwave {
  palette {
    background "#13001f"  text "#fdf4ff"  pink "#ff2bd6"  cyan "#22e4ff"
    blue "#22e4ff"  purple "#b36bff"  green "#3dffb5"  amber "#ffb13d"  red "#ff2b6a"  gray "#c9a6ff"
  }
  fonts { body "Outfit"  mono "JetBrains Mono"  fallback "sans-serif" }
  tokens { background "#13001f"  foreground "#fdf4ff"  border "#ff2bd6" }
  page {
    layer sun radial { from pink/0.28  to background  x 50  y 115 }
    layer grid grid { color pink/0.10  size 44 }
    fixed
  }
  node {
    layer glow glow { color pink/0.55  radius 18 }
    layer neon rect { radius 12 }
    layer gradient gradient { from pink  to cyan  angle 100 }
    // The neon gradient stays as a 2 px border around the dark interior, with a tint in the kind color.
    layer inner gradient { from background  to COLOR/0.25  angle 160  offset 2 2  grow -4 }
    // Colored dot over its ring, title with a pink glow and the spaced badge below.
    slots column min-width 160 slack 28 {
      row gap 10 pad 14 pad-y 0 min-height 50 {
        icon { variant dot  side 18  ring COLOR/0.25 }
        column {
          title { weight 700  glow pink/0.7  text-align start  leading 1.25 }
          badge { alpha 0.6  transform uppercase  size 0.66  tracking 0.18 }
        }
        counter { fill pink  border cyan }
      }
      attrs
    }
    type external { layer glow { color cyan/0.4  radius 12 }  layer gradient solid { color cyan/0.6 } }
    state hover { layer glow { color cyan/0.8  radius 28 }  transition 140ms ease-out }
    state on-path { layer glow { motion aura 2s ease-in-out intensity 0.6 } }
    state dimmed { layer glow none }
  }
  group {
    layer glow glow { color cyan/0.15  radius 20 }
    layer shape rect { radius 18 }
    layer fill solid { color cyan/0.04 }
    layer border border { color cyan/0.5 }
    slots row pad 12 pad-y 9 { title { transform uppercase  size 0.75  tracking 0.18  weight 600  fill COLOR/0.2  border COLOR/0.5  radius 50  pad 10  dot COLOR } }
    padding 12 22 22 22
    // Closed is the Node neon with its echo: a cyan outline offset below.
    state collapsed {
      layer echo border before glow { color cyan/0.5  offset 6 6 }
      layer glow { color pink/0.55  radius 18 }
      layer shape { radius 12 }
      layer fill gradient { from pink  to cyan  angle 100 }
      layer border none
      layer inner gradient after fill { from background  to COLOR/0.25  angle 160  offset 2 2  grow -4 }
    }
  }
  edge {
    layer halo line { color pink/0.18  width 8  corner round  radius 14 }
    layer line line { color cyan  width 1.8  corner round  radius 14 }
    start hollow { size 7  color text/0.7 }
    end arrow { size 10  color cyan }
    label { scale 0.82  pad 10  pad-y 2.5  radius 50  fill background  border pink/0.7  color text/0.8 }
  }
}
