// Contrast: none
// Editorial (Stripe Press style): cream paper, serif typography, only thin rules and no fill color.
// Gelasio (OFL, metrics compatible with Georgia) is the self-hosted serif of the prototype.
theme editorial {
  palette {
    background "#fbf8f1"  text "#1c1917"
    blue "#1d4ed8"  purple "#7e22ce"  green "#15803d"  amber "#b45309"  red "#b91c1c"  gray "#57534e"
  }
  fonts { body "Gelasio"  mono "JetBrains Mono"  fallback "serif" }
  tokens { background "#fbf8f1"  foreground "#1c1917"  border "#57534e" }
  node {
    // No shape or fill: one rule on top and a fainter one below.
    layer rule-top shadow { color text  x 0  y 1  inset 1 }
    layer rule-bottom shadow { color text/0.35  x 0  y -1  inset 1 }
    // No icon: large title in roman with the italic badge below.
    slots column min-width 170 slack 24 {
      row gap 10 pad 14 pad-y 0 min-height 58 {
        column {
          title { weight 400  size 1.25  text-align start  leading 1.25 }
          badge { alpha 0.6  style italic  size 0.8 }
        }
        counter { weight 700  fill background  border text/0.4 }
      }
      attrs
    }
    type package { layer rule-top { color COLOR  y 3 } }
    type external { layer rule-top { color text/0.35 } }
    state hover { layer rule-bottom { color COLOR  y -2 }  transition 150ms ease }
    state on-path { layer rule-top { color COLOR  y 3 } }
    state dimmed { layer rule-bottom none }
  }
  group {
    layer shape rect
    layer border border { color text/0.8 }
    slots row pad 18 pad-y 6 { title { transform uppercase  size 0.72  tracking 0.22  weight 600 } }
    padding 22 26 26 26
    // Closed is the Node rules, with the top one thick in the package color.
    state collapsed {
      layer border none
      layer rule-top shadow after shape { color COLOR  x 0  y 3  inset 1 }
      layer rule-bottom shadow after rule-top { color text/0.35  x 0  y -1  inset 1 }
    }
  }
  edge {
    layer line line { color text/0.75  width 0.8 }
    end chevron { size 9 }
    label { scale 0.82  pad 10  pad-y 2.5  radius 0  fill background  border background  style italic  color text/0.8 }
  }
}
