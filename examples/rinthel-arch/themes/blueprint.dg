// Contrast: none
// Technical blueprint: blue paper, thin strokes, drafting grid and right angles.
theme blueprint {
  palette {
    background "#0d3b73"  text "#e6f0ff"
    blue "#bfe0ff"  purple "#d9ccff"  green "#c4f5df"  amber "#ffe3a8"  red "#ffc2c2"  gray "#cfdcef"
  }
  fonts { body "JetBrains Mono"  mono "JetBrains Mono"  fallback "monospace" }
  tokens { background "#0d3b73"  foreground "#e6f0ff"  border "#e6f0ff" }
  page {
    layer thin grid { color text/0.06  size 20 }
    layer thick grid { color text/0.13  size 100 }
    fixed
  }
  node {
    layer shape rect
    layer fill solid { color background }
    // Blueprint double line: a second thin frame 4 px inside.
    layer inner border { color text/0.3  offset 4 4  grow -8 }
    layer border border { color text/0.9  width 1.5 }
    // Icon in a square box, uppercase title with the mono badge below and, in a closed Group, the counter.
    slots column min-width 170 slack 36 {
      row gap 10 pad 12 pad-y 0 min-height 54 {
        icon { variant box  side 26  radius 0  fill COLOR/0.12  border COLOR }
        column {
          title { weight 600  transform uppercase  size 0.86  tracking 0.06  text-align start  leading 1.25 }
          badge { alpha 0.6  font mono  size 0.7 }
        }
        counter { fill background  border text  font mono }
      }
      attrs
    }
    type external { layer border dashed { color text/0.8  width 1.5 }  layer inner none }
    state hover { layer fill { color text/0.08 }  transition 100ms linear }
    state on-path { layer border { color COLOR } }
    state dimmed { layer inner none }
  }
  group {
    layer shape rect
    layer border dashed { color text/0.6 }
    slots row pad 12 pad-y 9 {
      title { transform uppercase  font mono  size 0.75  leading 2  tracking 0.12  weight 600  fill background  border text  radius 4  pad 10 }
    }
    padding 7 22 22 22
    // Closed is the Node box with a dimension line in the kind color on the right edge.
    state collapsed {
      layer fill solid after shape { color background }
      layer border border { color text/0.9  width 1.5 }
      layer dimension shadow after border { color COLOR/0.6  x -6  y 0  inset 1 }
      layer inner border after dimension { color text/0.3  offset 4 4  grow -8 }
    }
  }
  edge {
    layer line line { color text/0.85  width 1 }
    start dot { size 4.4  color text/0.5 }
    end chevron { size 9 }
    label { scale 0.82  pad 10  pad-y 2.5  radius 0  fill background  border text/0.7  border-width 1.5  font mono  weight 700  color text/0.8 }
  }
}
