// Modelo de referencia para comparar un Tema con el prototipo aprobado (rama `prototype/render-hibrido`, ticket #46).
// Copia el Modelo del prototipo, con sus Tipos (paquete, modulo, artefacto, mas actor y externo de `modelo.dg`):
// paquetes del monorepo con Grupos abiertos, Grupos colapsados, Aristas con y sin etiqueta y Aristas elevadas.
// Vive bajo el Grupo `referencia` para que las Vistas de cobertura (`**`) lo excluyan.
// La Vista `<tema>-referencia` equivale a la Vista `abierto` del prototipo (ver `vistas.dg`).
specification {
  node paquete   { description "Paquete del monorepo"           icon box  color blue }
  node modulo    { description "Modulo dentro de un paquete"    icon box  color gray }
  node artefacto { description "Archivo o carpeta del Proyecto" icon box  color green }
}

model {
  dominio referencia "Referencia" {
    actor autor "Autor" "Escribe archivos .dg y mira los diagramas"
    actor agente "Agente" "Valida, consulta y edita por CLI"

    artefacto workspace "Workspace" "Carpeta de archivos .dg del Proyecto documentado"
    artefacto salida-derivada ".diagrams/" "Salida derivada; no se versiona"

    paquete canonico "canonico" "Esquema Zod, validacion y resolucion de Vistas" {
      modulo can-esquema "esquema" "Fuente canonica (Zod)"
      modulo can-validar "validar" "Issues con codigo y sugerencias"
      modulo can-vistas "vistas" "Resolucion de include, exclude y depth"
      modulo can-pasos "pasos" "Revelado paso a paso de Vistas flow"
      modulo can-pin "pin" "Pin: posicion fijada por el autor"
      modulo can-inspect "inspect" "Consultas sobre el Modelo"
    }

    paquete dsl "dsl" "Texto a Fuente canonica; fusion del Workspace" {
      modulo dsl-gramatica "gramatica" "Gramatica Langium"
      modulo dsl-compilar "compilar" "Archivos a Fuente canonica"
      modulo dsl-temas "temas" "Temas, paleta y tokens"
      modulo dsl-ubicador "ubicador" "Posiciones en el texto fuente"
    }

    paquete layout "layout" "ELK y Pin; geometria cacheada" {
      modulo lay-layout "layout" "Vista a geometria"
      modulo lay-metricas "metricas" "Medicion de texto"
      modulo lay-indice "indice" "Indice de geometria"
    }

    paquete sesion "sesion" "Tuberia compilar, validar y calcular layout" {
      modulo ses-sesion "sesion" "diagnosticar, construir, geometria"
      modulo ses-ediciones "ediciones" "Edicion estructurada del DSL"
      modulo ses-intenciones "intenciones" "Intenciones, deshacer y rehacer"
    }

    paquete render "render" "SVG React puro" {
      modulo ren-escena "escena" "Geometria a elementos"
      modulo ren-estilo "estilo" "Estilo resuelto contra el Tema"
      modulo ren-diagram "diagram" "Componente Diagram"
    }

    paquete shell "shell" "Interaccion en el navegador" {
      modulo sh-camara "camara" "Pan y zoom"
      modulo sh-colapso "colapso" "Colapso de Grupos"
      modulo sh-seleccion "seleccion" "Seleccion y arrastre de Pins"
      modulo sh-worker "layout-en-worker" "Relayout en Worker"
    }

    paquete cli "cli" "validate, build, export, inspect, edit, dev" {
      modulo cli-validate "validate" "Diagnosticos"
      modulo cli-export "export" "SVG, PNG y HTML"
      modulo cli-inspect "inspect" "Ids, sitios y vecinos"
      modulo cli-edit "edit" "Ediciones desde la terminal"
      modulo cli-dev "dev" "Servidor local con recarga"
    }

    externo elk "ELK (elkjs)" "Motor de layout"
    externo react "React 19" "Dibujo del SVG"
  }

  referencia.autor -> referencia.workspace "escribe .dg"
  referencia.agente -> referencia.cli "validate / inspect / edit"
  referencia.autor -> referencia.cli.cli-dev "abre el shell"
  referencia.cli -> referencia.workspace "lee"
  referencia.cli -> referencia.salida-derivada "escribe"

  referencia.dsl -> referencia.canonico
  referencia.layout -> referencia.canonico
  referencia.sesion -> referencia.canonico
  referencia.sesion -> referencia.dsl
  referencia.sesion -> referencia.layout
  referencia.render -> referencia.canonico
  referencia.render -> referencia.layout
  referencia.shell -> referencia.sesion
  referencia.shell -> referencia.render
  referencia.shell -> referencia.layout
  referencia.cli -> referencia.sesion
  referencia.cli -> referencia.render

  referencia.layout.lay-layout -> referencia.elk
  referencia.layout.lay-layout -> referencia.layout.lay-metricas
  referencia.layout.lay-indice -> referencia.layout.lay-layout
  referencia.sesion.ses-sesion -> referencia.dsl.dsl-compilar
  referencia.sesion.ses-sesion -> referencia.canonico.can-validar
  referencia.sesion.ses-sesion -> referencia.layout.lay-layout "memoiza por Vista"
  referencia.sesion.ses-ediciones -> referencia.dsl.dsl-ubicador
  referencia.sesion.ses-intenciones -> referencia.sesion.ses-ediciones
  referencia.render.ren-diagram -> referencia.react
  referencia.render.ren-diagram -> referencia.render.ren-escena
  referencia.render.ren-escena -> referencia.render.ren-estilo
  referencia.shell.sh-worker -> referencia.layout.lay-layout
  referencia.shell.sh-seleccion -> referencia.sesion.ses-intenciones
  referencia.shell.sh-colapso -> referencia.canonico.can-vistas
  referencia.cli.cli-validate -> referencia.sesion.ses-sesion
  referencia.cli.cli-inspect -> referencia.canonico.can-inspect
  referencia.cli.cli-edit -> referencia.sesion.ses-ediciones
  referencia.cli.cli-dev -> referencia.shell
  referencia.cli.cli-export -> referencia.render.ren-diagram
}
