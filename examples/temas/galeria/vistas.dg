view editorial-referencia { type architecture  theme editorial  include referencia.*, referencia.render.**, referencia.sesion.**, referencia.layout.**  expanded referencia.render, referencia.sesion, referencia.layout  collapsed referencia.canonico, referencia.dsl, referencia.shell, referencia.cli }
view bauhaus-referencia { type architecture  theme bauhaus  include referencia.*, referencia.render.**, referencia.sesion.**, referencia.layout.**  expanded referencia.render, referencia.sesion, referencia.layout  collapsed referencia.canonico, referencia.dsl, referencia.shell, referencia.cli }
view sticky-notes-referencia { type architecture  theme sticky-notes  include referencia.*, referencia.render.**, referencia.sesion.**, referencia.layout.**  expanded referencia.render, referencia.sesion, referencia.layout  collapsed referencia.canonico, referencia.dsl, referencia.shell, referencia.cli }
