view bauhaus-secuencia { type sequence  theme bauhaus  interaction cobro  order cliente, pasarela, plataforma.pedidos, plataforma.pagos, proveedor, plataforma.eventos  autonumber }
view sticky-notes-secuencia { type sequence  theme sticky-notes  interaction cobro  order cliente, pasarela, plataforma.pedidos, plataforma.pagos, proveedor, plataforma.eventos  autonumber }
view keycaps-secuencia { type sequence  theme keycaps  interaction cobro  order cliente, pasarela, plataforma.pedidos, plataforma.pagos, proveedor, plataforma.eventos  autonumber }
view metro-map-secuencia { type sequence  theme metro-map  interaction cobro  order cliente, pasarela, plataforma.pedidos, plataforma.pagos, proveedor, plataforma.eventos  autonumber }
