// Una Vista por Tema: el mismo Modelo, el Grupo `plataforma` abierto y `persistencia` colapsado.
// Sirve la galeria con `node packages/cli/dist/bin.js dev --workspace examples/temas/galeria --theme-path examples/rinthel-arch/temas`
// y cambia de Vista para comparar los 14 Temas.
view soft-card    { type architecture  theme soft-card     include **  exclude referencia, referencia.**, datos, datos.**  expanded plataforma, estados  collapsed persistencia }
view glass-chip   { type architecture  theme glass-chip    include **  exclude referencia, referencia.**, datos, datos.**  expanded plataforma, estados  collapsed persistencia }
view neobrutalist { type architecture  theme neobrutalist  include **  exclude referencia, referencia.**, datos, datos.**  expanded plataforma, estados  collapsed persistencia }
view blueprint    { type architecture  theme blueprint     include **  exclude referencia, referencia.**, datos, datos.**  expanded plataforma, estados  collapsed persistencia }
view claro-suave  { type architecture  theme claro-suave   include **  exclude referencia, referencia.**, datos, datos.**  expanded plataforma, estados  collapsed persistencia }
view crt-terminal { type architecture  theme crt-terminal  include **  exclude referencia, referencia.**, datos, datos.**  expanded plataforma, estados  collapsed persistencia }
view synthwave    { type architecture  theme synthwave     include **  exclude referencia, referencia.**, datos, datos.**  expanded plataforma, estados  collapsed persistencia }
view editorial    { type architecture  theme editorial     include **  exclude referencia, referencia.**, datos, datos.**  expanded plataforma, estados  collapsed persistencia }
view bauhaus      { type architecture  theme bauhaus       include **  exclude referencia, referencia.**, datos, datos.**  expanded plataforma, estados  collapsed persistencia }
view sticky-notes { type architecture  theme sticky-notes  include **  exclude referencia, referencia.**, datos, datos.**  expanded plataforma, estados  collapsed persistencia }
view keycaps      { type architecture  theme keycaps       include **  exclude referencia, referencia.**, datos, datos.**  expanded plataforma, estados  collapsed persistencia }
view metro-map    { type architecture  theme metro-map     include **  exclude referencia, referencia.**, datos, datos.**  expanded plataforma, estados  collapsed persistencia }
view pcb          { type architecture  theme pcb           include **  exclude referencia, referencia.**, datos, datos.**  expanded plataforma, estados  collapsed persistencia }
view pixel-art    { type architecture  theme pixel-art     include **  exclude referencia, referencia.**, datos, datos.**  expanded plataforma, estados  collapsed persistencia }
view soft-card-referencia { type architecture  theme soft-card  include referencia.*, referencia.render.**, referencia.sesion.**, referencia.layout.**  expanded referencia.render, referencia.sesion, referencia.layout  collapsed referencia.canonico, referencia.dsl, referencia.shell, referencia.cli }
