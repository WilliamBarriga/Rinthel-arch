view metro-map-referencia { type architecture  theme metro-map  include referencia.*, referencia.render.**, referencia.sesion.**, referencia.layout.**  expanded referencia.render, referencia.sesion, referencia.layout  collapsed referencia.canonico, referencia.dsl, referencia.shell, referencia.cli }
view pcb-referencia { type architecture  theme pcb  include referencia.*, referencia.render.**, referencia.sesion.**, referencia.layout.**  expanded referencia.render, referencia.sesion, referencia.layout  collapsed referencia.canonico, referencia.dsl, referencia.shell, referencia.cli }
view pixel-art-referencia { type architecture  theme pixel-art  include referencia.*, referencia.render.**, referencia.sesion.**, referencia.layout.**  expanded referencia.render, referencia.sesion, referencia.layout  collapsed referencia.canonico, referencia.dsl, referencia.shell, referencia.cli }

// Una Vista de secuencia y una ER por Tema: el mismo Modelo, otro Tipo de diagrama.
view soft-card-secuencia { type sequence  theme soft-card  interaction cobro  order cliente, pasarela, plataforma.pedidos, plataforma.pagos, proveedor, plataforma.eventos  autonumber }
view glass-chip-secuencia { type sequence  theme glass-chip  interaction cobro  order cliente, pasarela, plataforma.pedidos, plataforma.pagos, proveedor, plataforma.eventos  autonumber }
view neobrutalist-secuencia { type sequence  theme neobrutalist  interaction cobro  order cliente, pasarela, plataforma.pedidos, plataforma.pagos, proveedor, plataforma.eventos  autonumber }
