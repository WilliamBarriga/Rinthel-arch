// Contraste: ninguno
// Solo color: modulo/artefacto, paquete/artefacto, paquete/modulo
// Deliberado, como en el prototipo: sin insignia, en la Vista de referencia paquete, modulo y artefacto solo cambian de color.
// Mapa de metro: estaciones en pastilla con borde grueso y lineas gruesas del color del origen.
theme metro-map {
  palette {
    fondo "#ffffff"  texto "#111111"  blanco "#ffffff"
    blue "#0067b1"  purple "#8a3ffc"  green "#00953b"  amber "#b45f06"  red "#e3001b"  gray "#7a7a7a"
  }
  tokens { background "#ffffff"  foreground "#111111"  border "#111111" }
  node {
    layer forma pill
    layer relleno solid { color blanco }
    layer borde border { color texto  width 4 }
    slots { title { weight 700 }  attrs }
    type externo { layer borde dashed { color texto  width 4 } }
    state hover { layer relleno { color COLOR/0.12 }  layer borde { color COLOR }  transition 120ms ease-out }
    state en-ruta { layer borde { color COLOR  width 6 } }
    state atenuado { layer borde { color gray } }
  }
  edge {
    layer contorno line { color blanco width 11 }
    layer linea line { color ORIGEN width 6 }
    label { scale 0.8  pad 8  radius 3  fill texto  border texto }
  }
}
