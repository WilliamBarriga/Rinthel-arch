// Contraste: ninguno
// Terminal de fosforo (CRT): verde sobre negro, glow, lineas de barrido y Aristas punteadas.
theme crt-terminal {
  fonts { body "JetBrains Mono"  mono "JetBrains Mono" }
  palette {
    fondo "#020a04"  texto "#7dff9b"
    blue "#5cf2ff"  purple "#c49bff"  green "#7dff9b"  amber "#ffcc55"  red "#ff6b6b"  gray "#7dff9b"
  }
  tokens { background "#020a04"  foreground "#7dff9b"  border "#7dff9b" }
  node {
    layer glow glow { color COLOR/0.35  radius 10 }
    layer forma rect
    layer relleno solid { color fondo }
    layer tinte solid { color COLOR/0.1 }
    layer barrido lines { color texto/0.1  size 3  width 1  angle 0 }
    layer borde border { color COLOR  width 1 }
    slots { title { weight 700  transform uppercase }  attrs }
    type externo { layer glow none  layer borde dashed { color COLOR } }
    state hover { layer tinte { color COLOR/0.2 }  layer glow { radius 18 }  transition 80ms linear }
    state en-ruta { layer glow { color COLOR  motion pulso 1.2s ease-in-out intensity 0.5 } }
    state atenuado { layer glow none }
  }
  edge {
    layer halo line { color texto/0.12 width 5 }
    layer linea line { color texto  width 1.2  style dotted }
    start diamond { size 6 }
    end arrow { size 8 }
    label { scale 0.75  pad 4  radius 0  fill fondo  border texto }
  }
}
