// Contraste: ninguno
// Tarjeta sobria oscura (estilo Linear/Vercel): relleno translucido, borde fino y Aristas discretas.
theme soft-card {
  palette {
    fondo "#09090b"  texto "#fafafa"
    blue "#60a5fa"  purple "#a78bfa"  green "#34d399"  amber "#fbbf24"  red "#f87171"  gray "#a1a1aa"
  }
  tokens { background "#09090b"  foreground "#fafafa"  border "#a1a1aa"  radius 10 }
  page {
    layer puntos dots { color texto/0.1  size 22  radius 1 }
    fixed
  }
  node {
    layer caja rect { radius $radius }
    layer relleno solid { color texto/0.1 }
    layer borde border { color texto/0.4 width 1 }
    slots column {
      row gap 10 pad 10 {
        icon { variant box  side 28  radius 7  fill COLOR/0.14  border COLOR/0.45 }
        column {
          title { weight 600  text-align start  leading 1.25 }
          badge { alpha 0.5 }
        }
        counter { fill texto/0.08  border texto/0.15 }
      }
      attrs
    }
    type externo { layer borde dashed { color texto/0.5 } }
    type servicio { layer acento outline after borde { color COLOR/0.5 width 1 offset 0 } }
    state hover { layer borde { color COLOR }  transition 120ms ease-out }
    state en-ruta { layer borde { color COLOR  width 2 } }
    state atenuado { layer relleno none }
  }
  group {
    layer caja rect { radius 16 }
    layer relleno solid { color texto/0.03 }
    layer borde dashed { color texto/0.14  width 1 }
    slots row gap 8 pad 12 { title { dot COLOR  transform uppercase  size 0.8  tracking 0.1  alpha 0.6 } }
    padding 10 20 20 20
    state hover { layer borde { color texto/0.3 } }
    state collapsed {
      layer caja { radius $radius }
      layer relleno { color texto/0.1 }
      layer borde border { color texto/0.4  width 1 }
    }
  }
  edge {
    layer linea line { color texto/0.32 width 1.2  corner round  radius 6 }
    start dot { size 5 }
    end arrow { size 8 }
    label { scale 0.8  pad 6  radius 50  fill fondo  border texto/0.4 }
  }
}
