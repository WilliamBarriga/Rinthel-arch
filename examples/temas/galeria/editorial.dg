// Contraste: ninguno
// Editorial (estilo Stripe Press): papel crema, tipografia con serifa, solo reglas finas y sin color de relleno.
theme editorial {
  fonts { body "Georgia"  mono "Georgia" }
  palette {
    fondo "#fbf8f1"  texto "#1c1917"
    blue "#1d4ed8"  purple "#7e22ce"  green "#15803d"  amber "#b45309"  red "#b91c1c"  gray "#57534e"
  }
  tokens { background "#fbf8f1"  foreground "#1c1917"  border "#57534e" }
  node {
    layer forma rect
    layer relleno solid { color fondo }
    layer regla border { color texto  width 1 }
    slots { title { weight 400  style italic }  attrs }
    type servicio { layer regla { color COLOR  width 2 } }
    type externo { layer regla dotted { color texto  width 2 } }
    state hover { layer relleno { color texto/0.1 }  transition 150ms ease }
    state en-ruta { layer regla { color COLOR  width 3 } }
    state atenuado { layer regla { color gray  width 1 } }
  }
  edge {
    layer linea line { color texto/0.8 width 0.8 }
    end arrow { size 6 }
    label { scale 0.8  pad 6  radius 0  fill fondo  border fondo }
  }
}
