// Contraste: ninguno
// Synthwave neon: degradado rosa a cian con glow intenso y rejilla de fondo.
theme synthwave {
  palette {
    fondo "#13001f"  texto "#fdf4ff"  rosa "#ff2bd6"  cian "#22e4ff"
    blue "#22e4ff"  purple "#b36bff"  green "#3dffb5"  amber "#ffb13d"  red "#ff2b6a"  gray "#c9a6ff"
  }
  fonts { body "Outfit"  mono "JetBrains Mono"  fallback "sans-serif" }
  tokens { background "#13001f"  foreground "#fdf4ff"  border "#ff2bd6" }
  page {
    layer sol radial { from rosa/0.28  to fondo  x 50  y 115 }
    layer rejilla grid { color rosa/0.10  size 44 }
    fixed
  }
  node {
    layer glow glow { color rosa/0.55  radius 18 }
    layer neon rect { radius 12 }
    layer degradado gradient { from rosa  to cian  angle 100 }
    // El degradado neon queda como un borde de 2 px alrededor del interior oscuro, con un tinte del color del Tipo.
    layer interior gradient { from fondo  to COLOR/0.25  angle 160  offset 2 2  grow -4 }
    // Punto de color sobre su aro, titulo con resplandor rosa y la insignia espaciada debajo.
    slots column min-width 160 slack 28 {
      row gap 10 pad 14 pad-y 0 min-height 50 {
        icon { variant dot  side 18  ring COLOR/0.25 }
        column {
          title { weight 700  glow rosa/0.7  text-align start  leading 1.25 }
          badge { alpha 0.6  transform uppercase  size 0.66  tracking 0.18 }
        }
        counter { fill rosa  border cian }
      }
      attrs
    }
    type externo { layer glow { color cian/0.4  radius 12 }  layer degradado solid { color cian/0.6 } }
    state hover { layer glow { color cian/0.8  radius 28 }  transition 140ms ease-out }
    state en-ruta { layer glow { motion aura 2s ease-in-out intensity 0.6 } }
    state atenuado { layer glow none }
  }
  group {
    layer glow glow { color cian/0.15  radius 20 }
    layer forma rect { radius 18 }
    layer relleno solid { color cian/0.04 }
    layer borde border { color cian/0.5 }
    slots row pad 12 pad-y 9 { title { transform uppercase  size 0.75  tracking 0.18  weight 600  fill COLOR/0.2  border COLOR/0.5  radius 50  pad 10  dot COLOR } }
    padding 12 22 22 22
    // Cerrado es el neon del Nodo con su eco: un contorno cian desplazado debajo.
    state collapsed {
      layer eco border before glow { color cian/0.5  offset 6 6 }
      layer glow { color rosa/0.55  radius 18 }
      layer forma { radius 12 }
      layer relleno gradient { from rosa  to cian  angle 100 }
      layer borde none
      layer interior gradient after relleno { from fondo  to COLOR/0.25  angle 160  offset 2 2  grow -4 }
    }
  }
  edge {
    layer halo line { color rosa/0.18  width 8  corner round  radius 14 }
    layer linea line { color cian  width 1.8  corner round  radius 14 }
    start hollow { size 7  color texto/0.7 }
    end arrow { size 10  color cian }
    label { scale 0.82  pad 10  pad-y 2.5  radius 50  fill fondo  border rosa/0.7  color texto/0.8 }
  }
}
