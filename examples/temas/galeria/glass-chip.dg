// Contraste: ninguno
// Chip de vidrio (estilo Raycast/Arc): pastilla con glow, vidrio real (backdrop-filter) y brillo superior.
theme glass-chip {
  palette {
    fondo "#0a0a14"  texto "#eef0ff"  blanco "#ffffff"
    blue "#818cf8"  purple "#c084fc"  green "#2dd4bf"  amber "#fbbf24"  red "#fb7185"  gray "#94a3b8"
  }
  tokens { background "#0a0a14"  foreground "#eef0ff"  border "#94a3b8" }
  node {
    layer glow glow { color COLOR/0.35  radius 14 }
    layer forma pill
    layer vidrio glass { blur 10  saturate 140 }
    layer tinte gradient { from COLOR/0.30  to COLOR/0.1  angle 135 }
    layer borde border { color blanco/0.5 width 1 }
    layer brillo gradient over { from blanco/0.10  to blanco/0  angle 180 }
    slots { title { weight 500 }  attrs }
    type externo { layer glow none  layer borde dashed { color blanco/0.6 } }
    type actor { layer halo ring before glow { color COLOR/0.5  width 1  offset 5 } }
    state hover { layer glow { color COLOR/0.7  radius 22 }  transition 160ms ease-out }
    state en-ruta { layer glow { color COLOR  radius 26 } }
    state atenuado { layer glow none }
  }
  edge {
    layer halo line { color texto/0.12 width 6 }
    layer linea line { color texto/0.6 width 1.5 }
    start dot { size 6 }
    end arrow { size 9 }
    label { scale 0.8  pad 8  radius 50  fill fondo  border texto/0.5 }
  }
}
