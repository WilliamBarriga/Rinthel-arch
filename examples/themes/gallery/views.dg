view synthwave-er { type er  theme synthwave  include data.customers, data.orders-table, data.lines }
view editorial-er { type er  theme editorial  include data.customers, data.orders-table, data.lines }
view bauhaus-er { type er  theme bauhaus  include data.customers, data.orders-table, data.lines }
view sticky-notes-er { type er  theme sticky-notes  include data.customers, data.orders-table, data.lines }
view keycaps-er { type er  theme keycaps  include data.customers, data.orders-table, data.lines }
view metro-map-er { type er  theme metro-map  include data.customers, data.orders-table, data.lines }
view pcb-er { type er  theme pcb  include data.customers, data.orders-table, data.lines }
