{
  "name": "rinthel-arch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "pnpm build && pnpm typecheck && pnpm -r test && vitest run",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm check:deps && pnpm check:docs && pnpm check:emojis",
    "check:deps": "vitest run tests/dependencias.test.ts",
    "check:docs": "vitest run tests/documentacion.test.ts",
    "bench": "pnpm build && node bench/ejecutar.ts",
    "check:emojis": "node scripts/check-emojis.ts",
    "capturas": "node scripts/capturas.ts",
    "docs:capturas": "node scripts/docs-capturas.ts",
    "docs:catalogo": "node scripts/generar-referencia-catalogo.ts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "canonico": "workspace:*",
    "cli": "workspace:*",
    "dsl": "workspace:*",
    "esbuild": "^0.25.0",
    "eslint": "^10.14.0",
    "layout": "workspace:*",
    "playwright": "^1.64.0",
    "render": "workspace:*",
    "sesion": "workspace:*",
    "shell": "workspace:*",
    "tema": "workspace:*",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
