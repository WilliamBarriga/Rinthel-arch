{
  "name": "rinthel-arch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "pnpm build && pnpm typecheck && pnpm -r test && vitest run",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm check:deps && pnpm check:docs && pnpm check:emojis",
    "check:deps": "vitest run tests/dependencies.test.ts",
    "check:docs": "vitest run tests/documentation.test.ts",
    "bench": "pnpm build && node bench/run.ts",
    "check:emojis": "node scripts/check-emojis.ts",
    "screenshots": "node scripts/screenshots.ts",
    "docs:screenshots": "node scripts/docs-screenshots.ts",
    "docs:catalog": "node scripts/generate-theme-catalog.ts",
    "npm:package": "node scripts/build-npm-package.ts",
    "demo:publish": "node scripts/publish-demo.ts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "canonical": "workspace:*",
    "cli": "workspace:*",
    "dev-ui": "workspace:*",
    "dsl": "workspace:*",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "layout": "workspace:*",
    "playwright": "^1.64.0",
    "render": "workspace:*",
    "session": "workspace:*",
    "shell": "workspace:*",
    "theme": "workspace:*",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.11"
  }
}
