{
  "name": "rinthel-arch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "pnpm build && pnpm typecheck && pnpm -r test && vitest run",
    "check:deps": "vitest run tests/dependencias.test.ts",
    "bench": "pnpm build && node bench/ejecutar.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "canonico": "workspace:*",
    "cli": "workspace:*",
    "dsl": "workspace:*",
    "esbuild": "^0.25.0",
    "layout": "workspace:*",
    "shell": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
